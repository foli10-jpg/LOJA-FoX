<!DOCTYPE html>
<html lang="sq">
<head>
    <meta charset="UTF-8">
    <title>Loja e Thjeshtë</title>
    <style>
        body {
            text-align: center;
            font-family: Arial;
            margin-top: 40px;
        }

        #gameArea {
            width: 400px;
            height: 400px;
            background: #eee;
            border: 2px solid black;
            margin: auto;
            position: relative;
        }

        #ball {
            width: 40px;
            height: 40px;
            background: red;
            border-radius: 50%;
            position: absolute;
        }

        #score {
            font-size: 24px;
            margin-top: 20px;
        }
    </style>
</head>
<body>

<h2>Kliko topin sa më shpejt!</h2>

<div id="gameArea">
    <div id="ball"></div>
</div>

<div id="score">Piket: 0</div>

<script>
    let score = 0;
    const ball = document.getElementById("ball");
    const gameArea = document.getElementById("gameArea");

    function moveBall() {
        const x = Math.random() * (gameArea.clientWidth - 40);
        const y = Math.random() * (gameArea.clientHeight - 40);
        ball.style.left = x + "px";
        ball.style.top = y + "px";
    }

    ball.addEventListener("click", () => {
        score++;
        document.getElementById("score").innerHTML = "Piket: " + score;
        moveBall();
    });

    moveBall();
</script>

</body>
</html>
